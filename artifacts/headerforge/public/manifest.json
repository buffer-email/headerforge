{
  "manifest_version": 3,
  "name": "HeaderForge",
  "short_name": "HeaderForge",
  "description": "Local-first request and response header rules for developers.",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/headerforge-16.png",
    "32": "icons/headerforge-32.png",
    "48": "icons/headerforge-48.png",
    "128": "icons/headerforge-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/headerforge-16.png",
      "32": "icons/headerforge-32.png",
      "48": "icons/headerforge-48.png",
      "128": "icons/headerforge-128.png"
    },
    "default_title": "HeaderForge",
    "default_popup": "index.html"
  },
  "options_page": "options.html"
}
