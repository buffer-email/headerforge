{
  "manifest_version": 3,
  "name": "HeaderForge",
  "short_name": "HeaderForge",
  "description": "Local-first request and response header rules for developers.",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/headerforge-16.png",
    "32": "icons/headerforge-32.png",
    "48": "icons/headerforge-48.png",
    "128": "icons/headerforge-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/headerforge-16.png",
      "32": "icons/headerforge-32.png",
      "48": "icons/headerforge-48.png",
      "128": "icons/headerforge-128.png"
    },
    "default_title": "HeaderForge",
    "default_popup": "index.html"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; connect-src 'self'"
  }
}